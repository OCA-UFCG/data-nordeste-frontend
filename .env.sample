# Description: Sample environment variables for the project
# Environment variables

# The URL of the host 
export NEXT_PUBLIC_HOST_URL="http://localhost:3000"

# Google Analytics ID (e.g., G-Z0N0RCX00X)
export NEXT_PUBLIC_GA_ID=""

# Contentful credencials
NEXT_PUBLIC_CONTENTFUL_PREVIEW=
NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=""
NEXT_PUBLIC_CONTENTFUL_SPACE=""

# Firebase configuration
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_SURVEY_FEEDBACK_URL=""

# Firebase App Check (ReCaptcha V3)
NEXT_PUBLIC_RECAPTCHA_KEY=""

# Automatic Reporting service used by the browser report preview.
NEXT_PUBLIC_AUTOMATIC_REPORT_API_URL="http://127.0.0.1:8000"

# Read-only Postgres connection used by the /demo/pib prototype (server-side only).
# Locally it goes through the SSH tunnel, e.g. postgres://user:pass@localhost:5433/oca_db
DATA_DB_URL=""

# Password for /atualizar-conteudo, which clears the Contentful cache (server-side only).
# Empty disables the page.
CONTENT_CACHE_PASSWORD=""

# Token shared with Automatic-Reporting (same value there) for the "Atualizar
# relatórios" button on /atualizar-conteudo (server-side only). Empty disables it.
DOCS_ATUALIZAR_TOKEN=""

# Liga as rotas /demo/* (server-side). Só o gamma seta; vazio = 404. Para ver as demos local: 1
DEMOS_HABILITADAS=""

# Diretório com os geodados dos mapas dos painéis, gerado por scripts/geodata (server-side only).
# Vazio = /api/geodata responde 503. Localmente, aponte para o diretório gerado.
GEODATA_DIR=""
