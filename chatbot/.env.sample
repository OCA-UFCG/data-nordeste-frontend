# Conexão com o oca_db, usada só por "npm run tabelao" e "npm run conferir" (só leitura).
# Sem estas variáveis, scripts/com-banco.sh lê DB_HOST, DB_PORT, DB_USER,
# DB_PASSWORD e DB_DATABASE do .env do Automatic-Reporting (DATANE_PG_ENV).
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
DATANE_PG_ENV=~/Automatic-Reporting/.env

# Página de chat (todas opcionais).
DATANE_CHAT_PORTA=3220
DATANE_CHAT_MOTOR=claude
DATANE_CHAT_MODELOS=haiku,sonnet

# Conteúdo do portal (npm run portal): lê NEXT_PUBLIC_CONTENTFUL_SPACE e
# NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN do .env do frontend (DATANE_FRONTEND_ENV).
DATANE_FRONTEND_ENV=~/datanordeste/data-nordeste-frontend/.env
